{
  "schemaVersion": 1,
  "id": "structurevoidable",
  "version": "${version}",
  "name": "StructureVoidable",
  "description": "Client side mod to make using the block Structure Void easier",
  "authors": [
    "VgLevelUp"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/structurevoidable",
    "sources": "https://github.com/Vg34100/Minecraft-StructureVoidable",
    "issues": "https://github.com/Vg34100/Minecraft-StructureVoidable/issues"
  },
  "license": "MIT",
  "icon": "assets/structurevoidable/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.vg.structurevoidable.fabric.StructurevoidableFabric"
    ],
    "client": [
      "net.vg.structurevoidable.fabric.client.StructurevoidableFabricClient"
    ],
    "modmenu": [
      "net.vg.structurevoidable.fabric.modmenu.StructureVoidableModMenu"
    ]
  },
  "mixins": [
    "structurevoidable.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu" : {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/structurevoidable",
        "modmenu.discord": "https://discord.gg/Xfcysgn3jU",
        "modmenu.donate": "https://buymeacoffee.com/vglevelup"
      }
    }
  }
}
